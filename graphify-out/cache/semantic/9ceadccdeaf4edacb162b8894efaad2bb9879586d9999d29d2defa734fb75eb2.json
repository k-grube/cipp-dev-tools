{"nodes": [{"id": "cipp_docs_dev_documentation_contributing_to_the_code", "label": "Contributing to the Code", "file_type": "document", "source_file": "CIPP/docs/dev-documentation/contributing-to-the-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cipp_docs_dev_documentation_contributing_to_the_code_pull_request_workflow", "label": "PR Workflow (dev-only, Conventional Commits)", "file_type": "rationale", "source_file": "CIPP/docs/dev-documentation/contributing-to-the-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "all PRs target the dev branch; main is the current release and does not accept direct PRs; use a Conventional Commits title; keep PRs focused, a bug fix and a new feature belong in separate PRs"}, {"id": "cipp_docs_dev_documentation_contributing_to_the_code_function_naming_convention", "label": "Invoke- Function Naming Convention", "file_type": "rationale", "source_file": "CIPP/docs/dev-documentation/contributing-to-the-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "every HTTP endpoint handler under backend/Modules/CIPPHTTP/ must use an Invoke-List*/Add*/Edit*/Remove*/Exec* prefix; the HTTP router maps the CIPPEndpoint route parameter to Invoke-{CIPPEndpoint}, so the function name is exactly what appears in the URL"}, {"id": "cipp_docs_dev_documentation_contributing_to_the_code_tenantid_parameter_requirement", "label": "Always Pass -tenantid to Graph/Exo Requests", "file_type": "rationale", "source_file": "CIPP/docs/dev-documentation/contributing-to-the-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "omitting -tenantid on New-GraphGetRequest, New-GraphPOSTRequest, New-GraphBulkRequest, and New-ExoRequest hits the partner tenant instead of the customer"}, {"id": "cipp_docs_dev_documentation_contributing_to_the_code_modulebuilder_compilation", "label": "ModuleBuilder-Compiled Backend Modules", "file_type": "rationale", "source_file": "CIPP/docs/dev-documentation/contributing-to-the-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "backend/Modules/ are ModuleBuilder-compiled; editing a source file does nothing until it is recompiled, the module watcher handles this automatically during local development"}, {"id": "cipp_docs_dev_documentation_contributing_to_the_code_native_apis_over_powershell_modules", "label": "Native APIs Over PowerShell Modules", "file_type": "rationale", "source_file": "CIPP/docs/dev-documentation/contributing-to-the-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PowerShell modules slow the entire runtime; the backend currently loads only Az.Keyvault and Az.Accounts and prefers to keep it that way"}, {"id": "cipp_docs_dev_documentation_contributing_to_the_code_pester_tests", "label": "Pester Test Suite (backend/Tests/Invoke-CippTests.ps1)", "file_type": "concept", "source_file": "CIPP/docs/dev-documentation/contributing-to-the-code.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "cipp_docs_dev_documentation_contributing_to_the_code", "target": "cipp_docs_dev_documentation_cipp_dev_guide_setting_up_for_local_development", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CIPP/docs/dev-documentation/contributing-to-the-code.md", "source_location": null, "weight": 1.0}, {"source": "cipp_docs_dev_documentation_contributing_to_the_code", "target": "cipp_docs_dev_documentation_cipp_dev_guide_project_structure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CIPP/docs/dev-do