{"nodes": [{"id": "cipp_docs_user_documentation_tenant_conditional_list_policies_readme_ca_policies", "label": "CA Policies", "file_type": "document", "source_file": "CIPP/docs/user-documentation/tenant/conditional/list-policies/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cipp_docs_user_documentation_tenant_conditional_list_policies_readme_deploy_ca_policy_wizard", "label": "Deploy Conditional Access Policy Wizard", "file_type": "concept", "source_file": "CIPP/docs/user-documentation/tenant/conditional/list-policies/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cipp_docs_user_documentation_tenant_conditional_list_policies_readme_replace_ids_with_display_names", "label": "Replace IDs with Display Names", "file_type": "rationale", "source_file": "CIPP/docs/user-documentation/tenant/conditional/list-policies/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CA policies reference users, groups, and named locations by tenant-specific GUIDs, so a template built in tenant A will not resolve in tenant B. This mode enumerates target-tenant users/groups and substitutes display-name references with the matching target GUIDs (special tokens All/None/GuestOrExternalUsers pass through). CIPP Standards always use this mode so template deployments stay portable across tenants without extra configuration."}, {"id": "cipp_docs_user_documentation_tenant_conditional_list_policies_readme_create_groups_if_missing", "label": "Create Groups If Missing", "file_type": "rationale", "source_file": "CIPP/docs/user-documentation/tenant/conditional/list-policies/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When a group named in a CA template does not exist in the target tenant, CIPP creates it (from a matching CIPP Group Template if one exists, else a basic security group) so cross-tenant deployments do not fail. Disabled, a missing group aborts deployment with an error so it can be created or renamed manually."}, {"id": "cipp_docs_user_documentation_tenant_conditional_list_policies_readme_conditionalaccesspolicy_graph_resource", "label": "conditionalAccessPolicy Graph Resource", "file_type": "concept", "source_file": "CIPP/docs/user-documentation/tenant/conditional/list-policies/README.md", "source_location": null, "source_url": "https://learn.microsoft.com/en-us/graph/api/resources/conditionalaccesspolicy?view=graph-rest-1.0#properties", "captured_at": null, "author": null, "contributor": null}, {"id": "cipp_docs_user_documentation_tenant_conditional_list_policies_readme_ca_template_creation", "label": "CA Template Creation", "file_type": "concept", "source_file": "CIPP/docs/user-documentation/tenant/conditional/list-policies/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creating a template from an existing CA policy translates and stores inclusions/exclusions in CIPP so redeployment on any tenant carries every setting, including named locations and authentication strengths."}, {"id": "cipp_docs_user_documentation_cipp_logs_readme_logs", "label": "CIPP Logs", "file_type": "document", "source_file": "CIPP/docs/user-documentation/tenant/conditional/list-policies/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "cipp_docs_user_documentation_tenant_conditional_list_policies_readme_ca_policies", "target": "cipp_docs_user_documentation_tenant_conditional_list_policies_readme_deploy_ca_policy_wizard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CIPP/docs/user-documentation/tenant/conditional/list-policies/README.md", "source_loca