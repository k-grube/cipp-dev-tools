{"nodes": [{"id": "spec_toolchain_notes_doc", "label": "Frontend toolchain notes", "file_type": "document", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_toolchain_notes_upstream_findings_doc", "label": "docs\\upstream-findings.md", "file_type": "document", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_toolchain_notes_yarn_registry_rewrite", "label": "yarn classic registry rewrite (cleanRegistry)", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "yarn classic rewrites npmjs -> yarnpkg in the lock only when the configured registry === https://registry.yarnpkg.com exactly, no trailing slash (strict string match in yarn source); a trailing slash silently disables the rewrite"}, {"id": "spec_toolchain_notes_npmrc_yarnrc", "label": "frontend/.npmrc + frontend/.yarnrc", "file_type": "document", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_toolchain_notes_yarnpkg_issue_5891", "label": "yarnpkg/yarn#5891", "file_type": "document", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "closed 2019 with 'keeping the CNAME up for the foreseeable future' - yarnpkg.com was never deprecated and is still yarn's default"}, {"id": "spec_toolchain_notes_vite_8_rolldown", "label": "Vite 8 (rolldown-based)", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ignores esbuild config entirely"}, {"id": "spec_toolchain_notes_vite_pin_7_3_6", "label": "Vite pinned to 7.3.6 via resolutions", "file_type": "rationale", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "codebase is JSX-in-.js, all three loader overrides depend on esbuild.loader:'jsx'; vite 8 drops that so vite is pinned via yarn v1 resolutions (otherwise vite 8 nests under vitest). unpin after the jsx-in-js rename"}, {"id": "spec_toolchain_notes_vitest_4_browser_provider", "label": "Vitest 4 browser provider change", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@vitest/browser is gone, playwright provider is @vitest/browser-playwright and browser.provider takes the imported playwright(), not a string"}, {"id": "spec_toolchain_notes_storybook_addon_vitest_deprecation", "label": "@storybook/addon-vitest deprecated vitest.init() call", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "thru 10.5.3 still calls the deprecated vitest.init(); the 'use vitest.standalone()' warning is upstream storybook's problem, ignore it"}, {"id": "spec_toolchain_notes_coverage_merge", "label": "yarn test:coverage merges both projects", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "browser coverage works via CDP in chromium; story-only components showing real percentages is the proof it merges"}, {"id": "spec_toolchain_notes_async_util_timeout", "label": "asyncUtilTimeout: 10000", "file_type": "rationale", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "coverage instrumentation slows lazy chunks/fetches past testing-library's 1s default waitFor; set globally in frontend/vitest.setup.js and frontend/.storybook/vitest.setup.js, never add per-call timeouts"}, {"id": "spec_toolchain_notes_sb_mock_noop_gotcha", "label": "sb.mock() silent no-op gotcha", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "storybook only extracts sb.mock calls from the preview config; a story-file sb.mock is a silent no-op. use story-level msw handlers + seed the react-query cache instead"}, {"id": "spec_toolchain_notes_mui_label_duplicate_gotcha", "label": "MUI outlined input label duplication", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MUI outlined inputs render the label text twice (label + fieldset legend); getByLabelText throws multiple-match, use getByRole('textbox', {name:...}) instead"}, {"id": "spec_toolchain_notes_next_dynamic_mock", "label": "next/dynamic jsdom mock", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "next/dynamic components never resolve in jsdom without the alias mock (tests/mocks/next-dynamic.js, React.lazy + Suspense); their assertions must be async"}, {"id": "spec_toolchain_notes_react_hooks_lint_ref", "label": "react-hooks lint rejects ref.current=x in component bodies", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "applies to test harnesses too; assign in a useEffect"}, {"id": "spec_toolchain_notes_apicall_mock_requirement", "label": "vi.mock of src/api/ApiCall export requirement", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "must export ApiGetCall, ApiPostCall, AND ApiGetCallWithPagination; deep component trees pull all three"}, {"id": "spec_toolchain_notes_cippdatatable_mrt_workaround", "label": "CippDataTable row-selection jsdom workaround", "file_type": "rationale", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "can't be driven through row selection in jsdom because MRT's row+column virtualizers measure 0, so zero th/tbody tr render and the select-all checkbox is unreachable; render CIPPTableToptoolbar directly against a real useMaterialReactTable instance and call table.toggleAllRowsSelected(true) after mount (the toolbar's effect on [usedData] clears selection on mount), and since the toolbar is React.memo at least one prop must change identity per render (pass getRequestData as an inline literal)"}, {"id": "spec_toolchain_notes_require_context_plugin", "label": "cipp-require-context pre-plugin", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "require.context needs this plugin in vitest.config.mjs (unit project), not just tests/mocks/require-context.js - vitest's per-module cjs require shadows the globalThis patch"}, {"id": "spec_toolchain_notes_graph_degree_ranking", "label": "graph-degree test-candidate ranking", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rank candidates by graph degree - load graphify-out/graph.json (node-link format, edges under links), sum degree per source_file under frontend/src/components"}, {"id": "spec_toolchain_notes_cipptablepage", "label": "CippTablePage", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "found via graph-degree ranking as #2 by degree with zero tests, after code reviews missed it"}, {"id": "spec_toolchain_notes_dev_stack_psd1_rewrite", "label": "dev stack psd1 manifest rewrite noise", "file_type": "concept", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "the dev stack rewrites backend/Modules/*/[Name].psd1 manifests via App__Worker__DevExpandModuleExports in build/docker-compose-all.yml; CIPPTests.psd1 showing modified is stack noise, never commit it"}, {"id": "spec_toolchain_notes_graphify_out_graph_json", "label": "graphify-out/graph.json", "file_type": "document", "source_file": "spec/toolchain-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "spec_toolchain_notes_doc", "target": "spec_toolchain_notes_upstream_findings_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "spec/toolchain-notes.md", "source_location": null, "weight": 1.0}, {"source": "spec_toolchain_notes_doc", "target": "spec_toolchain_notes_yarn_registry_rewrite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "spec/toolchain-notes.md", "source_location": null, "weight": 1.0}, {"source": "spec_toolchain_notes_yarn_registry_rewrite", "target": "spec_toolchain_notes_npmrc_yarnrc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "spec/toolchain-notes.md", "source_location": null, "weight": 1.0}, {"source": "spec_toolchain_notes_yarn_registry_rewrite