{"nodes": [{"id": "cipp_docs_user_documentation_tenant_standards_readme_standards_and_drift", "label": "Standards & Drift Overview", "file_type": "document", "source_file": "CIPP/docs/user-documentation/tenant/standards/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cipp_docs_user_documentation_tenant_standards_readme_classic_standards", "label": "Classic Standards", "file_type": "concept", "source_file": "CIPP/docs/user-documentation/tenant/standards/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "baseline settings automatically re-enforced every 12 hours; deselecting a standard stops future enforcement but does not undo already-applied config; since v7 standards operate via templates instead of per-tenant edit pages, one-time Convert Standards migration required"}, {"id": "cipp_docs_user_documentation_tenant_standards_readme_drift_management", "label": "Drift Management", "file_type": "concept", "source_file": "CIPP/docs/user-documentation/tenant/standards/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "new in v8.3 for managing client environments with a finer touch than auto-remediating classic standards; evaluates every 12 hours, fixed to Report and Alert actions so nothing changes without an explicit per-deviation decision"}, {"id": "cipp_docs_user_documentation_tenant_standards_readme_standard_actions", "label": "Standard Actions (Report / Alert / Remediate)", "file_type": "concept", "source_file": "CIPP/docs/user-documentation/tenant/standards/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remediate implicitly enables Report in the backend so remediated standards always show in reports"}, {"id": "cipp_docs_user_documentation_tenant_standards_re