{"nodes": [{"id": "cipp_docs_setup_resources_how_cipp_evaluates_roles_how_cipp_evaluates_roles", "label": "How CIPP Evaluates Roles", "file_type": "document", "source_file": "CIPP/docs/setup/resources/how-cipp-evaluates-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "cipp_docs_setup_resources_how_cipp_evaluates_roles_built_in_roles_ceiling", "label": "Built-in Roles as Permission Ceiling", "file_type": "rationale", "source_file": "CIPP/docs/setup/resources/how-cipp-evaluates-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "built-in roles (readonly < editor < admin < superadmin) set the maximum a user can ever do; when a user holds several via group membership the single highest role wins rather than roles adding together, and admin/superadmin bypass custom roles entirely"}, {"id": "cipp_docs_setup_resources_how_cipp_evaluates_roles_custom_roles_allow_list", "label": "Custom Roles as Explicit Allow-List", "file_type": "rationale", "source_file": "CIPP/docs/setup/resources/how-cipp-evaluates-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "a custom role grants exactly what it defines; any permission category left unset is treated as None (a deny); paired with a base role it narrows that role's ceiling, used alone it applies with no ceiling at all"}, {"id": "cipp_docs_setup_resources_how_cipp_evaluates_roles_role_impersonation", "label": "Role Impersonation Testing", "file_type": "concept", "source_file": "CIPP/docs/setup/resources/how-cipp-evaluates-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "cipp_docs_setup_resources_how_cipp_evaluates_roles_how_cipp_evaluates_roles", "target": "cipp_docs_setup_resources_how_