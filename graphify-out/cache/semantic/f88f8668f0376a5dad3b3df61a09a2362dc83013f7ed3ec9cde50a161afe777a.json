rce_file": "CIPP/frontend/tests/Overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "chosen over @storybook/nextjs because many deps (heroicons, MUI v7, tiptap) are ESM-only and webpack's babel transpilation fails on them without explicit per-package config, and the codebase uses JSX in .js files needing another babel plugin; Vite handles ESM natively and the esbuild loader override handles JSX-in-.js with no transpilation config, at the cost of manually mocking Next.js modules via Vite aliases"}, {"id": "cipp_frontend_tests_overview_jsx_in_js_loader", "label": "JSX-in-.js esbuild loader override", "file_type": "concept", "source_file": "CIPP/frontend/tests/Overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "the codebase uses JSX syntax in .js files rather than .jsx; Vite's esbuild only handles JSX in .jsx files by default, so both .storybook/main.mjs and vitest.config.mjs override the esbuild loader to treat .js files as JSX"}, {"id": "cipp_frontend_tests_overview_coverage_merge", "label": "Merged Coverage (jsdom + browser)", "file_type": "concept", "source_file": "CIPP/frontend/tests/Overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@storybook/addon-vitest converts stories into vitest browser tests run under Playwright/Chromium; yarn test:coverage includes both unit tests (jsdom) and storybook tests (real browser), with coverage merged into a single report"}], "edges": [{"source": "cipp_frontend_tests_overview_cipp_component_library", "target": "cipp_frontend_tests_overview_csf3_stories", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CIPP/frontend/tests/Overview.mdx", "source_location": null, "weight": 1.0}, {"source": "cipp_frontend_tests_overview_csf3_stories", "target": "cipp_f