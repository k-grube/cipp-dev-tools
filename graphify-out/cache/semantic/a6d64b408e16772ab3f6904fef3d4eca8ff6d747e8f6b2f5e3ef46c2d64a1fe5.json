{"nodes": [{"id": "cipp_docs_setup_resources_how_cipp_evaluates_roles_how_cipp_evaluates_roles", "label": "How CIPP Evaluates Roles", "file_type": "document", "source_file": "cipp/docs/setup/resources/how-cipp-evaluates-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cipp_docs_setup_resources_how_cipp_evaluates_roles_built_in_role_ceiling", "label": "Built-in Role Ceiling (Highest Wins)", "file_type": "rationale", "rationale": "built-in roles (readonly -> editor -> admin -> superadmin) set the maximum a user can do; multiple built-ins do not add together, the single highest wins", "source_file": "cipp/docs/setup/resources/how-cipp-evaluates-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cipp_docs_setup_resources_how_cipp_evaluates_roles_custom_role_allow_list", "label": "Custom Role Explicit Allow-List", "file_type": "rationale", "rationale": "unset permission categories are denies; with a base role the custom role narrows the ceiling, alone it grants exactly what it defines; multiple custom roles union but tenant scope is checked per role", "source_file": "cipp/docs/setup/resources/how-cipp-evaluates-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cipp_docs_setup_resources_how_cipp_evaluates_roles_admin_bypasses_custom_roles", "label": "Admin Bypasses Custom Roles", "file_type": "rationale", "rationale": "admin/superadmin ignore custom roles entirely; to restrict a user assign editor or readonly plus a custom role instead", "source_file": "cipp/docs/setup/resources/how-cipp-evaluates-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "cipp_docs_setup_resources_how_cipp_evaluates_roles_how_cipp_evaluates_roles", "target": "cipp_docs_setup_resources_how_cipp_ev